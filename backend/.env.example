# Локальная разработка без Docker: SQLite, без Redis
APP_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
JWT_SECRET=dev-secret-change-me-please-use-32+bytes
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEED_ON_START=true
CREATE_TABLES_ON_START=true
CHECK_STEP_DELAY=0.6
# REDIS_URL=redis://localhost:6379/0
# LLM_BASE_URL=http://localhost:11434   # Ollama, модели с открытыми весами
# LLM_MODEL=qwen2.5:7b-instruct
