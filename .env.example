# ── только для сервера (локально не нужно) ──
# WEB_PORT=80                                  # порт сайта на сервере
# WEB_BIND=127.0.0.1                           # за HTTPS-прокси (Caddy): сайт слушает только локально
# COOKIE_SECURE=true                           # включайте, когда сайт открывается по https
# CORS_ORIGINS=["https://example.com"]         # адрес сайта; за nginx-прокси на тот же домен можно не менять
# SEED_ON_START=true                           # демо-аккаунты; false — не создавать
